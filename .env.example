# LLM Configuration
# Option 1: Anthropic (Claude) -- langchain-anthropic is already installed
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Option 2: OpenAI or OpenAI-compatible endpoint (DeepSeek, ZhipuAI/GLM, Moonshot, etc.)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# LLM provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_MODEL_NAME=claude-sonnet-4-20250514

# RAG Configuration
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# HuggingFace mirror (optional, for Chinese users with firewall restrictions)
# HF_ENDPOINT=https://hf-mirror.com

# MCP Configuration
MCP_SERVER_SCRIPT=mcp_server.py
TRAVEL_PLANS_DIR=./travel_plans